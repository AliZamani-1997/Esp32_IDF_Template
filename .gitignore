# ===== ESP-IDF generated / local artifacts =====
# These are produced by the build system and must never be committed.
build/
managed_components/
dependencies.lock

# sdkconfig is user-local; sdkconfig.defaults IS tracked.
sdkconfig
sdkconfig.old

# ===== Editor / IDE =====
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json.bak
.cache/
.clangd/
compile_commands.json

# ===== Machine-specific ESP-IDF configuration =====
# eim_config.toml is the ESP-IDF Installation Manager's record of the install:
# absolute paths, valid only on the machine that produced it.
eim_config.toml

# Per-machine toolchain activation, called by tools/idf-env.cmd when present.
# Only needed when automatic detection fails; see tools/idf-env.local.cmd.example.
tools/idf-env.local.cmd

# ===== OS junk =====
Thumbs.db
desktop.ini
.DS_Store

# ===== Local agent/workspace state =====
.workbuddy-ai/*
!.workbuddy-ai/skills/

# ===== graphify knowledge graph (generated) =====
# Regenerable from the source tree, and graphify-out/.graphify_python +
# cache/ hold machine-local absolute paths. Rebuild with:
#   graphify . --update
graphify-out/

# ===== Scratch / throwaway experiments =====
.scratch/
